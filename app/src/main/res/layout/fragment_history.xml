<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="tickets"
            type="java.util.List&lt;woowacourse.movie.view.reservation.Ticket>" />

        <variable
            name="onItemClick"
            type="woowacourse.movie.view.reservation.history.OnReservationEventListener" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/history_fragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".view.reservation.history.HistoryFragment">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_reservation_history"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:itemCount="10"
            tools:listitem="@layout/reservation_history_item"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:items="@{tickets}"
            app:itemClickListener="@{onItemClick}">
        </androidx.recyclerview.widget.RecyclerView>


    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>