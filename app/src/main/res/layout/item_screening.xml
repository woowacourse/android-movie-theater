<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="screening"
            type="woowacourse.movie.domain.reservation.Screening" />

        <variable
            name="posterDrawable"
            type="Integer" />

        <variable
            name="onClickReserveListener"
            type="android.view.View.OnClickListener" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <ImageView
            android:id="@+id/iv_item_screening_poster"
            android:layout_width="76dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="15dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/cd_poster"
            app:srcDrawable="@{posterDrawable}"
            tools:src="@drawable/poster_harry_potter_and_the_philosophers_stone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_item_screening_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="13dp"
                android:text="@{screening.title}"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="해리 포터와 마법사의 돌" />

            <TextView
                android:id="@+id/tv_item_screening_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="@{@string/screening_period(screening.startYear,screening.startMonth,screening.startDay,screening.endYear,screening.endMonth,screening.endDay)}"
                android:textColor="@color/black"
                android:textSize="12sp"
                tools:text="@string/screening_period" />

            <TextView
                android:id="@+id/tv_item_screening_running_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="@{@string/running_time(screening.runningTime)}"
                android:textColor="@color/black"
                android:textSize="12sp"
                tools:text="@string/running_time" />

            <Button
                android:id="@+id/btn_item_screening_reserve"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:onClickListener="@{onClickReserveListener}"
                android:paddingHorizontal="16dp"
                android:paddingVertical="10dp"
                android:text="@string/item_screening_reserve"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>
</layout>