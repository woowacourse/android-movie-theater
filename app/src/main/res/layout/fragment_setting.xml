<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/setting_fragment"
    tools:context=".view.setting.SettingFragment">

    <TextView
        android:id="@+id/tv_warning_to_receive_alarm"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:textColor="@color/black"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:text="@string/push_alarm_receiver"/>

    <TextView
        android:id="@+id/tv_receive_alarm"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="@id/tv_warning_to_receive_alarm"
        app:layout_constraintTop_toBottomOf="@id/tv_warning_to_receive_alarm"
        android:text="@string/warning_push_alarm"/>

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/sw_notification"
        android:textColor="@color/black"
        android:textStyle="bold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:thumbTint="@drawable/switch_thumb_color"
        app:trackTint="@drawable/switch_track_color"
        app:layout_constraintBottom_toBottomOf="@+id/tv_receive_alarm"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.936"
        app:layout_constraintStart_toEndOf="@+id/tv_warning_to_receive_alarm"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.769" />


</androidx.constraintlayout.widget.ConstraintLayout>
</layout>