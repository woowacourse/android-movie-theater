<?xml version="1.0" encoding="utf-8"?>
<layout>

    <data>
        <variable
            name="model"
            type="woowacourse.movie.view.history.adapter.model.TickRvItem.TicketItem" />

        <variable
            name="eventListener"
            type="woowacourse.movie.view.history.adapter.TicketViewHolder.Handler" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:onClick="@{() -> eventListener.onClick(model.id)}"
        android:padding="10dp">

        <TextView
            android:id="@+id/tv_date"
            android:text="@{model.bookingDate}"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/black"
            android:textSize="12sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="2024.3.2" />

        <View
            android:id="@+id/date_divider"
            android:layout_width="2dp"
            android:layout_height="16dp"
            android:layout_marginStart="8dp"
            android:background="@color/gray"
            app:layout_constraintStart_toEndOf="@id/tv_date"
            app:layout_constraintTop_toTopOf="@id/tv_date" />

        <TextView
            android:id="@+id/tv_time"
            android:text="@{model.bookingTime}"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="@color/black"
            android:textSize="12sp"
            app:layout_constraintBaseline_toBaselineOf="@id/tv_date"
            app:layout_constraintStart_toEndOf="@id/date_divider"
            tools:text="17:00" />

        <View
            android:id="@+id/time_divider"
            android:layout_width="2dp"
            android:layout_height="16dp"
            android:layout_marginStart="8dp"
            android:background="@color/gray"
            app:layout_constraintStart_toEndOf="@id/tv_time"
            app:layout_constraintTop_toTopOf="@id/tv_time" />

        <TextView
            android:id="@+id/tv_theater_name"
            android:text="@{model.theaterName}"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="@color/black"
            android:textSize="12sp"
            app:layout_constraintBaseline_toBaselineOf="@id/tv_date"
            app:layout_constraintStart_toEndOf="@id/time_divider"
            tools:text="선릉 극장" />

        <TextView
            android:id="@+id/tv_movie_name"
            android:text="@{model.movieName}"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_date"
            tools:text="해리 포터와 마법사의 돌" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
