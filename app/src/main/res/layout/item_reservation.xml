<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="woowacourse.movie.ui.view.util.DateTimeFormatUtil" />

        <variable
            name="ticket"
            type="woowacourse.movie.domain.ticket.Ticket" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="70dp">

        <TextView
            android:id="@+id/text_view_item_screening_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:maxLines="1"
            android:text="@{@string/screening_info(DateTimeFormatUtil.dateFormat(ticket.showtime, @string/date_format),DateTimeFormatUtil.timeFormat(ticket.showtime, @string/time_format),ticket.cinemaName)}"
            android:textSize="12sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="2024.3.2 | 17:00 | 선릉 극장" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="12dp"
            android:text="@{ticket.title}"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/text_view_item_screening_info"
            app:layout_goneMarginTop="12dp"
            tools:text="해리 포터와 마법사의 돌" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/default_line"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>