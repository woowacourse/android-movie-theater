<?xml version="1.0" encoding="utf-8"?>
<layout>

    <androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="66dp"
        android:clickable="true"
        android:background="?attr/selectableItemBackground">


        <TextView
            android:id="@+id/tv_stored_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:textColor="@color/black"
            android:textSize="12sp"
            android:textStyle="normal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/tv_stored_title"
            app:layout_constraintVertical_chainStyle="packed"

            tools:text="2024.3.2" />

        <TextView
            android:id="@+id/tv_line"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/light_gray"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:textSize="12sp"
            android:textStyle="normal"
            app:layout_constraintStart_toEndOf="@id/tv_stored_date"
            app:layout_constraintTop_toTopOf="@id/tv_stored_date"
            app:layout_constraintEnd_toStartOf="@id/tv_stored_time"
            tools:text="|" />



        <TextView
            android:id="@+id/tv_stored_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/black"
            android:textSize="12sp"
            android:textStyle="normal"
            app:layout_constraintStart_toEndOf="@id/tv_line"
            app:layout_constraintEnd_toStartOf="@id/tv_line2"
            app:layout_constraintTop_toTopOf="@id/tv_stored_date"

            tools:text="17:00" />

        <TextView
            android:id="@+id/tv_line2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/light_gray"
            android:textSize="12sp"
            android:textStyle="normal"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            app:layout_constraintStart_toEndOf="@id/tv_stored_time"
            app:layout_constraintTop_toTopOf="@id/tv_stored_date"
            app:layout_constraintEnd_toStartOf="@id/tv_stored_cinema"
            tools:text="|" />

        <TextView
            android:id="@+id/tv_stored_cinema"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/black"
            android:textSize="12sp"
            android:textStyle="normal"
            app:layout_constraintStart_toEndOf="@id/tv_line2"
            android:layout_marginStart="4dp"
            app:layout_constraintTop_toTopOf="@id/tv_stored_time"

            tools:text="선릉 극장" />

        <TextView
            android:id="@+id/tv_stored_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@+id/tv_stored_date"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"

            tools:text="해리 포터와 마법사의 돌" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
