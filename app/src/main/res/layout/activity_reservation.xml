<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_reservation"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/iv_reservation_poster"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_gravity="center_horizontal"
            android:contentDescription="@string/cd_poster"
            android:scaleType="centerCrop"
            android:src="@drawable/poster_harry_potter_and_the_philosophers_stone"
            app:layout_constraintDimensionRatio="360:341"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_reservation_movie_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="27dp"
            android:ellipsize="end"
            android:gravity="start"
            android:maxLines="1"
            android:paddingHorizontal="20dp"
            android:textColor="@color/black"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/iv_reservation_poster"
            tools:text="해리포터와 마법사의 돌, 해리포터와 마법사의 돌, 해리포터와 마법사의 돌" />

        <TextView
            android:id="@+id/tv_reservation_movie_period"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="29dp"
            android:ellipsize="end"
            android:gravity="start"
            android:maxLines="1"
            android:paddingHorizontal="20dp"
            android:textColor="@color/black"
            android:textSize="16sp"
            app:layout_constraintTop_toBottomOf="@id/tv_reservation_movie_title"
            tools:text="상영일: 2025.4.1 ~ 2025.4.25상영일: 2025.4.1 ~ 2025.4.25상영일: 2025.4.1 ~ 2025.4.25" />

        <TextView
            android:id="@+id/tv_reservation_movie_running_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="start"
            android:maxLines="1"
            android:paddingHorizontal="20dp"
            android:textColor="@color/black"
            android:textSize="16sp"
            app:layout_constraintTop_toBottomOf="@id/tv_reservation_movie_period"
            tools:text="러닝타임: 152분 러닝타임: 152분 러닝타임: 152분 러닝타임: 152분" />

        <Spinner
            android:id="@+id/spinner_reservation_screening_date"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="29dp"
            android:layout_marginEnd="13dp"
            android:layout_weight="1"
            android:paddingVertical="13dp"
            app:layout_constraintEnd_toStartOf="@id/spinner_reservation_screening_time"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_reservation_movie_running_time" />

        <Spinner
            android:id="@+id/spinner_reservation_screening_time"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="13dp"
            android:layout_marginEnd="29dp"
            android:layout_weight="1"
            android:paddingVertical="13dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/spinner_reservation_screening_date"
            app:layout_constraintTop_toBottomOf="@id/tv_reservation_movie_running_time" />

        <Button
            android:id="@+id/btn_reservation_minus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="20dp"
            android:layout_weight="1"
            android:text="@string/reservation_minus_symbol"
            android:textSize="25sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/spinner_reservation_screening_date" />

        <TextView
            android:id="@+id/tv_reservation_audience_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="3"
            android:gravity="center"
            android:textAlignment="center"
            android:textColor="@color/black"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/btn_reservation_minus"
            app:layout_constraintEnd_toStartOf="@id/btn_reservation_plus"
            app:layout_constraintStart_toEndOf="@id/btn_reservation_minus"
            app:layout_constraintTop_toTopOf="@id/btn_reservation_minus"
            tools:text="1" />

        <Button
            android:id="@+id/btn_reservation_plus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="20dp"
            android:layout_weight="1"
            android:text="@string/reservation_plus_symbol"
            android:textSize="25sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/spinner_reservation_screening_time" />

        <Button
            android:id="@+id/btn_reservation_select_complete"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="25dp"
            android:layout_marginBottom="20dp"
            android:paddingVertical="11dp"
            android:text="@string/reservation_select_complete"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_reservation_audience_count" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>
