<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="70dp">

    <TextView
        android:id="@+id/tv_screening_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12.5dp"
        android:textColor="@color/black"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="2025.3.4" />

    <TextView
        android:id="@+id/date_time_divider"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12.5dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:textColor="@color/history_text_divider"
        android:textSize="12sp"
        app:layout_constraintEnd_toStartOf="@id/tv_screening_time"
        app:layout_constraintStart_toEndOf="@id/tv_screening_date"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="|" />

    <TextView
        android:id="@+id/tv_screening_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12.5dp"
        android:textColor="@color/black"
        android:textSize="12sp"
        app:layout_constraintEnd_toStartOf="@id/time_theater_divider"
        app:layout_constraintStart_toEndOf="@id/date_time_divider"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="17:00" />

    <TextView
        android:id="@+id/time_theater_divider"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12.5dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:textColor="@color/history_text_divider"
        android:textSize="12sp"
        app:layout_constraintStart_toEndOf="@id/tv_screening_time"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="|" />

    <TextView
        android:id="@+id/tv_theater_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="@color/black"
        android:textSize="12sp"
        app:layout_constraintStart_toEndOf="@id/time_theater_divider"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="선릉 극장" />

    <TextView
        android:id="@+id/tv_movie_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="6dp"
        android:textColor="@color/black"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_screening_date"
        tools:text="해리 포터와 마법사의 돌" />

</androidx.constraintlayout.widget.ConstraintLayout>