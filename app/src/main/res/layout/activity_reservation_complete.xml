<?xml version="1.0" encoding="utf-8"?>
<layout>

    <data>

        <variable
            name="movieTicket"
            type="woowacourse.movie.model.ticket.MovieTicket" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/reservation_complete"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <TextView
            android:id="@+id/tv_reservation_complete_information"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@color/purple_9160f9"
            android:gravity="center"
            android:paddingTop="66dp"
            android:paddingBottom="10dp"
            android:text="@string/reservation_complete_information"
            android:textColor="@color/white"
            android:textSize="15sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_reservation_complete_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:text="@{movieTicket.title}"
            android:textColor="@color/black"
            android:textSize="25sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_reservation_complete_information"
            tools:text="라라랜드" />

        <TextView
            android:id="@+id/tv_reservation_complete_timestamp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:movieDate="@{movieTicket.movieDate}"
            android:movieTime="@{movieTicket.movieTime}"
            android:textColor="@color/black"
            android:textSize="20sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_reservation_complete_title"
            tools:text="2025.4.15 11:00" />

        <TextView
            android:id="@+id/tv_reservation_complete_ticket_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="80dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:seats="@{movieTicket.seats}"
            android:textColor="@color/black"
            android:textSize="20sp"
            android:theater="@{movieTicket.theater}"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_reservation_complete_timestamp"
            tools:text="일반 3명 | C3, C2, C1 | 엄청나게 긴 극장이름입니다" />

        <TextView
            android:id="@+id/tv_reservation_complete_ticket_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@{@string/reservation_complete_ticket_price(movieTicket.price())}"
            android:textColor="@color/black"
            android:textSize="20sp"
            app:layout_constraintEnd_toEndOf="@id/tv_reservation_complete_ticket_count"
            app:layout_constraintStart_toStartOf="@id/tv_reservation_complete_ticket_count"
            app:layout_constraintTop_toBottomOf="@id/tv_reservation_complete_ticket_count"
            tools:text="39,000원 (현장 결제)" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
