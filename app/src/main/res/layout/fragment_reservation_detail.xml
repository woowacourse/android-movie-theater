<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="movie"
            type="woowacourse.movie.presentation.common.model.MovieUiModel" />

        <variable
            name="reservationCount"
            type="woowacourse.movie.presentation.common.model.ReservationCountUiModel" />

        <variable
            name="dates"
            type="java.util.List&lt;java.time.LocalDate>" />

        <variable
            name="selectedDate"
            type="java.time.LocalDate" />

        <variable
            name="times"
            type="java.util.List&lt;java.time.LocalTime>" />

        <variable
            name="selectedTime"
            type="java.time.LocalTime" />

        <variable
            name="onCountClickListener"
            type="woowacourse.movie.presentation.home.reservation.detail.OnCountClickListener" />

    </data>

    <ScrollView
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        tools:context=".presentation.view.reservation.detail.ReservationDetailActivity">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/iv_reservation_poster"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:contentDescription="@string/movie_poster"
                android:scaleType="centerCrop"
                app:bitmapFromRes="@{movie.poster.toInt()}"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintTop_toTopOf="parent"
                tools:src="@drawable/harrypotter" />

            <TextView
                android:id="@+id/tv_reservation_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="28dp"
                android:text="@{movie.title}"
                android:textColor="@color/black"
                android:textSize="24sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/iv_reservation_poster"
                tools:text="해리 포터와 마법사의 돌" />

            <TextView
                android:id="@+id/tv_screening_period"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="28dp"
                android:text="@{String.format(@string/movie_date, movie.screeningPeriod.formatedStartDate(@string/movie_screening_period_format), movie.screeningPeriod.formatedEndDate(@string/movie_screening_period_format))}"
                android:textColor="@color/black"
                android:textSize="16sp"
                app:layout_constraintTop_toBottomOf="@id/tv_reservation_title"
                tools:text="상영일: 2025.4.1 ~ 2025.4.25" />

            <TextView
                android:id="@+id/tv_reservation_running_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:text="@{String.format(@string/running_time, movie.runningTime)}"
                android:textColor="@color/black"
                android:textSize="16sp"
                app:layout_constraintTop_toBottomOf="@id/tv_screening_period"
                tools:text="러닝타임: 152분" />

            <Spinner
                android:id="@+id/spinner_reservation_date"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="36dp"
                app:items="@{dates}"
                app:layout_constraintEnd_toStartOf="@id/spinner_reservation_time"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_reservation_running_time"
                app:selectedItem="@{selectedDate}" />

            <Spinner
                android:id="@+id/spinner_reservation_time"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                app:items="@{times}"
                app:layout_constraintBottom_toBottomOf="@id/spinner_reservation_date"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/spinner_reservation_date"
                app:layout_constraintTop_toTopOf="@id/spinner_reservation_date"
                app:selectedItem="@{selectedTime}" />

            <Button
                android:id="@+id/btn_reservation_count_minus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:enabled="@{!reservationCount.isMin()}"
                android:onClick="@{() -> onCountClickListener.onCountDecrease()}"
                android:text="@string/reservation_count_minus"
                android:textSize="20sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@id/tv_reservation_count"
                app:layout_constraintEnd_toStartOf="@id/tv_reservation_count"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/tv_reservation_count" />

            <TextView
                android:id="@+id/tv_reservation_count"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="28dp"
                android:gravity="center"
                android:text="@{String.valueOf(reservationCount.count)}"
                android:textColor="@color/black"
                android:textSize="20sp"
                app:layout_constraintEnd_toStartOf="@id/btn_reservation_count_plus"
                app:layout_constraintStart_toEndOf="@id/btn_reservation_count_minus"
                app:layout_constraintTop_toBottomOf="@id/spinner_reservation_date"
                tools:text="1" />

            <Button
                android:id="@+id/btn_reservation_count_plus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:enabled="@{!reservationCount.isMax()}"
                android:onClick="@{() -> onCountClickListener.onCountIncrease()}"
                android:text="@string/reservation_count_plus"
                android:textSize="20sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@id/tv_reservation_count"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/tv_reservation_count"
                app:layout_constraintTop_toTopOf="@id/tv_reservation_count" />

            <Button
                android:id="@+id/btn_reservation_finish"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:text="@string/reservation_finish_button_text"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_reservation_count" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>
</layout>
