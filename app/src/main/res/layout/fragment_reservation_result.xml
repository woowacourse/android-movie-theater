<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="ticket"
            type="woowacourse.movie.presentation.model.TicketBundleUiModel" />

        <variable
            name="cancellationTime"
            type="Integer" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        tools:context=".presentation.view.home.reservation.result.ReservationResultFragment">

        <TextView
            android:id="@+id/tv_cancel_description"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@color/purple_9160F9"
            android:paddingTop="66dp"
            android:paddingBottom="10dp"
            android:text='@{String.format(@string/reservation_result_cancel_time_description, cancellationTime)}'
            android:textAlignment="center"
            android:textColor="@color/white"
            android:textSize="15sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_movie_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:textColor="@color/black"
            android:textSize="25sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_cancel_description"
            android:text="@{ticket.title}" />

        <TextView
            android:id="@+id/tv_movie_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:textColor="@color/black"
            android:textSize="20sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_movie_title"
            android:text="@{ticket.formatedDateTime(@string/reservation_datetime_format)}" />

        <TextView
            android:id="@+id/tv_reservation_count_info"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_marginTop="80dp"
            android:text="@{String.format(@string/reservation_count_info, ticket.size, ticket.joinedLabel, ticket.theaterName)}"
            android:textAlignment="center"
            android:textColor="@color/black"
            android:textSize="20sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_movie_date" />

        <TextView
            android:id="@+id/tv_reservation_total_price"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@{String.format(@string/reservation_total_price, ticket.totalPrice)}"
            android:textAlignment="center"
            android:textColor="@color/black"
            android:textSize="20sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_reservation_count_info" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
