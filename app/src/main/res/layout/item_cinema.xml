<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="8dp">

    <TextView
        android:id="@+id/text_view_item_cinema_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/black"
        android:textSize="16sp"
        app:layout_constraintBottom_toTopOf="@id/text_view_item_cinema_showtime_count"
        app:layout_constraintEnd_toStartOf="@id/image_view_item_cinema_arrow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="선릉 극장 선릉 극장 선릉 극장 선릉 극장 선릉 극장 선릉 극장 선릉 극장 선릉 극장" />

    <TextView
        android:id="@+id/text_view_item_cinema_showtime_count"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#5F5F5F"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/text_view_item_cinema_name"
        app:layout_constraintStart_toStartOf="@id/text_view_item_cinema_name"
        app:layout_constraintTop_toBottomOf="@id/text_view_item_cinema_name"
        tools:text="N개의 상영 시간N개의 상영 시간 N개의 상영 시간 N개의 상영 시간 N개의 상영 시간 N개의 상영 시간" />

    <ImageView
        android:id="@+id/image_view_item_cinema_arrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginVertical="15dp"
        android:layout_marginEnd="8dp"
        android:contentDescription="@string/content_description_item_cinema_navigation"
        android:src="@drawable/arrow_right"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>