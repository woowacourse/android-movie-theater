<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="bookingInfo"
            type="woowacourse.movie.feature.model.BookingInfoUiModel" />

        <variable
            name="handler"
            type="woowacourse.movie.feature.bookinghistory.view.adapter.BookingHistoryViewHolder.Handler" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:onClick="@{() -> handler.onBookingHistoryClick(bookingInfo)}"
        android:padding="12dp">

        <TextView
            android:id="@+id/tv_booking_history_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@{bookingInfo.date.toString()}"
            android:textColor="@color/black"
            android:textSize="12sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="2024.3.2" />

        <TextView
            android:id="@+id/tv_booking_history_divider_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/booking_history_divider"
            android:textColor="@color/gray_150"
            android:textSize="12sp"
            app:layout_constraintStart_toEndOf="@id/tv_booking_history_date"
            app:layout_constraintTop_toTopOf="@id/tv_booking_history_date" />

        <TextView
            android:id="@+id/tv_booking_history_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@{bookingInfo.movieTime.toString()}"
            android:textColor="@color/black"
            android:textSize="12sp"
            app:layout_constraintStart_toEndOf="@id/tv_booking_history_divider_date"
            app:layout_constraintTop_toTopOf="@id/tv_booking_history_date"
            tools:text="17:00" />

        <TextView
            android:id="@+id/tv_booking_history_divider_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/booking_history_divider"
            android:textColor="@color/gray_150"
            android:textSize="12sp"
            app:layout_constraintStart_toEndOf="@id/tv_booking_history_time"
            app:layout_constraintTop_toTopOf="@id/tv_booking_history_date" />

        <TextView
            android:id="@+id/tv_booking_history_theater"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@{bookingInfo.theaterName}"
            android:textColor="@color/black"
            android:textSize="12sp"
            app:layout_constraintStart_toEndOf="@id/tv_booking_history_divider_time"
            app:layout_constraintTop_toTopOf="@id/tv_booking_history_date"
            tools:text="선릉 극장" />

        <TextView
            android:id="@+id/tv_booking_history_movie_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@{bookingInfo.movie.title}"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_booking_history_date"
            tools:text="레디 플레이어 원" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>