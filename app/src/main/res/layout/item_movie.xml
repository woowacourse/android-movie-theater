<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="movie"
            type="woowacourse.movie.feature.model.MovieUiModel" />

        <variable
            name="handler"
            type="woowacourse.movie.feature.home.view.adapter.MovieViewHolder.Handler" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="132dp"
        android:padding="12dp">

        <ImageView
            android:id="@+id/iv_movie_poster"
            android:layout_width="76dp"
            android:layout_height="0dp"
            android:scaleType="centerCrop"
            app:imgRes="@{movie.poster}"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:background="@color/black" />

        <TextView
            android:id="@+id/tv_movie_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="@{movie.title}"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/iv_movie_poster"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="영화 제목" />

        <TextView
            android:id="@+id/tv_movie_date_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/movies_movie_date_label"
            android:textSize="12sp"
            app:layout_constraintStart_toStartOf="@id/tv_movie_title"
            app:layout_constraintTop_toBottomOf="@id/tv_movie_title" />

        <TextView
            android:id="@+id/tv_movie_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@{@string/movies_movie_date_with_tilde(movie.startDate.toString(), movie.endDate.toString())}"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="@id/tv_movie_date_label"
            app:layout_constraintStart_toEndOf="@id/tv_movie_date_label"
            app:layout_constraintTop_toTopOf="@id/tv_movie_date_label"
            tools:text="2025.4.1" />

        <TextView
            android:id="@+id/tv_movie_running_time_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/movies_movie_running_time_label"
            android:textSize="12sp"
            app:layout_constraintStart_toStartOf="@id/tv_movie_date_label"
            app:layout_constraintTop_toBottomOf="@id/tv_movie_date_label" />

        <TextView
            android:id="@+id/tv_movie_running_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:text="@{@string/movies_movie_running_time(movie.runningTime)}"
            app:layout_constraintBottom_toBottomOf="@id/tv_movie_running_time_label"
            app:layout_constraintStart_toEndOf="@id/tv_movie_running_time_label"
            app:layout_constraintTop_toTopOf="@id/tv_movie_running_time_label"
            tools:text="152분" />

        <Button
            android:id="@+id/btn_movie_booking"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/movies_movie_booking_now"
            android:onClick="@{() -> handler.onBookingClick(movie)}"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
