<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="movieScreeningInfoByTheater"
            type="woowacourse.movie.model.theater.MovieScreeningInfoByTheater" />

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/theater_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="8dp">

        <TextView
            android:id="@+id/theater_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="@{movieScreeningInfoByTheater.screeningInfo.theater.name}"
            android:textColor="@color/black"
            android:textSize="16sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="선릉극장" />

        <TextView
            android:id="@+id/theater_screening_time_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@{@string/theater_movie_screening_time_count(String.valueOf(movieScreeningInfoByTheater.screeningInfo.screeningTimes.size()))}"
            android:textColor="@color/gray_5F5F5F"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@+id/theater_name"
            app:layout_constraintTop_toBottomOf="@+id/theater_name"
            tools:text="3개의 상영 시간" />

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:src="@drawable/chevron_right"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
