<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="ticket"
            type="woowacourse.movie.ui.model.TicketUiModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".booking.complete.BookingCompleteActivity">

        <TextView
            android:id="@+id/screening_info_layout"
            android:layout_width="match_parent"
            android:layout_height="114dp"
            android:layout_marginBottom="15dp"
            android:background="@color/screening_info_bg"
            android:gravity="bottom|center_horizontal"
            android:paddingBottom="10dp"
            android:text="@string/screening_info"
            android:textColor="@color/white"
            android:textSize="15sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_complete_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:text="@{ticket.title}"
            android:textColor="@color/black"
            android:textSize="25sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/screening_info_layout"
            tools:text="예매한 영화 제목" />


        <TextView
            android:id="@+id/tv_complete_screening_date_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginTop="20dp"
            android:text="@{@string/formatted_screening_date_time(ticket.selectedDateText, ticket.selectedTimeText)}"
            android:textColor="@color/black"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_complete_title"
            tools:text="영화 상영시간" />

        <TextView
            android:id="@+id/tv_ticket"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="80dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="@{@string/formatted_screening_complete_ticket(ticket.headCount, ticket.seats, @string/text_theater_place(ticket.theater))}"
            android:textColor="@color/black"
            android:textSize="20sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_complete_screening_date_time"
            tools:text="일반 N명 | A1, A2 | 극장 이름" />

        <TextView
            android:id="@+id/tv_booking_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@{@string/formatted_complete_booking_amount(ticket.totalPrice)}"
            android:textColor="@color/black"
            android:textSize="20sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_ticket"
            tools:text="26,000원 (현장 결제)" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
