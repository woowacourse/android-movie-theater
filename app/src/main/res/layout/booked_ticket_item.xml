<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="stringFormatter"
            type="woowacourse.movie.utils.StringFormatter" />

        <variable
            name="bookedTicket"
            type="woowacourse.movie.domain.model.theater.BookedTicket" />

        <variable
            name="bookedTicketClickListener"
            type="woowacourse.movie.ui.history.view.BookedTicketClickListener" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_booked_ticket_item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:onClick="@{() -> bookedTicketClickListener.onClick(bookedTicket)}">

        <TextView
            android:id="@+id/tv_dateTime_theaterName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="12dp"
            android:text="@{stringFormatter.dateTimeTheaterName(bookedTicket)}"
            android:textColor="@color/black"
            android:textSize="12sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="2024.3.2 | 13:00 | 선릉 극장" />

        <TextView
            android:id="@+id/tv_movieName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:paddingBottom="12dp"
            android:text="@{bookedTicket.movieName}"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="@id/tv_dateTime_theaterName"
            app:layout_constraintTop_toBottomOf="@id/tv_dateTime_theaterName"
            tools:text="해리 포터와 마법사의 돌" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>