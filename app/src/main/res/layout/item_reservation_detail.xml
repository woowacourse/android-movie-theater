<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="movieTicketEntity"
            type="woowacourse.movie.data.entity.MovieTicketEntity" />

        <variable
            name="onReservationDetailClick"
            type="kotlin.jvm.functions.Function1" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/selectableItemBackground"
        android:onClick="@{() -> onReservationDetailClick.invoke(movieTicketEntity.reservationInfoEntity.id)}"
        android:padding="12dp">

        <TextView
            android:id="@+id/tv_reservation_detail_theaterInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:text="@string/reservation_detail_ticket_info"
            android:maxLines="1"
            android:textColor="@color/black"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="2024.3.2 | 17:00 | 엄청 긴 이름을 가진 선릉선릉선릉정릉정릉극장입 극장입니다만 어떻게 " />

        <TextView
            android:id="@+id/tv_reservation_detail_movie_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@{movieTicketEntity.movie.title}"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/tv_reservation_detail_theaterInfo"
            app:layout_constraintTop_toBottomOf="@id/tv_reservation_detail_theaterInfo"
            tools:text="해리 포터와 마법사의 돌" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
