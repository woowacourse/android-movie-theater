<?xml version="1.0" encoding="utf-8"?>

<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <data>

        <variable
            name="movieTicket"
            type="woowacourse.movie.model.ticket.MovieTicket" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="@drawable/item_border">

        <TextView
            android:id="@+id/tv_selected_date_time_theater"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:text='@{String.format(@string/reservation_details_selected_date_time_theater, movieTicket.selectedDate, movieTicket.selectedTime.value, movieTicket.theater.name)}'
            tools:text="2024.3.2 | 17:00 | 선릉 극장" />

        <TextView
            android:id="@+id/tv_movie_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:layout_editor_absoluteX="0dp"
            android:text="@{movieTicket.title}"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            tools:text="해리포터와 마법사의 돌" />


    </LinearLayout>


</layout>
