<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="80dp">

    <TextView
        android:id="@+id/textview_booking_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:textSize="12sp"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="2024.4.1" />

    <TextView
        android:id="@+id/booking_separator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="2dp"
        android:layout_marginTop="12dp"
        android:text="@string/booked_separator"
        android:textSize="12sp"
        app:layout_constraintStart_toEndOf="@+id/textview_booking_date"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textview_booking_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="2dp"
        android:layout_marginTop="12dp"
        android:textSize="12sp"
        app:layout_constraintStart_toEndOf="@+id/booking_separator"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="13:00" />

    <TextView
        android:id="@+id/booking_separator2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="2dp"
        android:layout_marginTop="12dp"
        android:text="@string/booked_separator"
        android:textSize="12sp"
        app:layout_constraintStart_toEndOf="@+id/textview_booking_time"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textview_booking_theater"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="2dp"
        android:layout_marginTop="12dp"
        android:textSize="12sp"
        app:layout_constraintStart_toEndOf="@+id/booking_separator2"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="선릉 극장" />

    <TextView
        android:id="@+id/textview_booking_movie_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="6dp"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textview_booking_date"
        tools:text="영화 제목" />

</androidx.constraintlayout.widget.ConstraintLayout>
